# Server
PORT=3100
HOST=127.0.0.1

# PostgreSQL
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password
PGDATABASE=lab_content

# CASUYA Integration (for CORS + API key validation)
CASUYA_ORIGIN=http://localhost:3000
API_KEY=your-secret-api-key

# Admin Auth
ADMIN_PASSWORD=your-admin-password

# Docker (used in docker-compose.yml)
# PGPASSWORD=postgres
# API_KEY=lab-content-secret-key
# ADMIN_PASSWORD=admin123
# CASUYA_ORIGIN=http://localhost:3000
